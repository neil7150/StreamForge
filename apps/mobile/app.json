{
  "expo": {
    "name": "StreamForge",
    "slug": "streamforge",
    "extra": { "runtimeMode": "device-local" },
    "version": "1.0.1",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "streamforge",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#090d16"
    },
    "android": {
      "versionCode": 2,
      "package": "com.streamforge.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#090d16"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "DEFAULT",
            "BROWSABLE"
          ],
          "data": [
            {
              "scheme": "magnet"
            }
          ]
        },
        {
          "action": "VIEW",
          "category": [
            "DEFAULT",
            "BROWSABLE"
          ],
          "data": [
            {
              "scheme": "streamforge"
            }
          ]
        }
      ],
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-screen-orientation",
      "expo-video",
      ["expo-dev-client", { "addGeneratedScheme": false, "launchMode": "most-recent" }],
      "./plugins/with-localhost-cleartext",
      "./plugins/with-android-release",
      "./plugins/with-android-test-build",
      "./plugins/with-android-development"
    ]
  }
}
