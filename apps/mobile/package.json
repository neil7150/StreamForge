{
  "name": "streamforge-mobile",
  "version": "1.0.0",
  "main": "index.js",
  "private": true,
  "scripts": {
    "start": "expo start",
    "start:tunnel": "expo start --tunnel --clear",
    "setup:android": "powershell -ExecutionPolicy Bypass -File ./scripts/setup-android.ps1",
    "build:native:android": "powershell -ExecutionPolicy Bypass -File ../../services/torrent-daemon/build-android-aar.ps1",
    "preandroid": "npm run build:native:android",
    "android": "powershell -ExecutionPolicy Bypass -File ./scripts/run-android.ps1",
    "prebuild:android": "npm run build:native:android",
    "build:android": "powershell -ExecutionPolicy Bypass -File ./scripts/run-android.ps1 -AssembleOnly",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "@streamforge/core": "*",
    "expo": "^57.0.0",
    "expo-constants": "~57.0.18",
    "expo-linking": "~57.0.10",
    "expo-screen-orientation": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-video": "~57.0.4",
    "lucide-react-native": "^0.460.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "^19.2.4",
    "typescript": "^5.7.2"
  },
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./modules"
    }
  }
}
