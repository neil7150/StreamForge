# Generate fresh secrets; never use example text as a real value.
POSTGRES_PASSWORD=REPLACE_WITH_64_HEXADECIMAL_CHARACTERS
JWT_SECRET=REPLACE_WITH_64_HEXADECIMAL_CHARACTERS
# Absolute directory on the server; certificate must cover your backend domain.
TLS_CERT_DIR=/etc/streamforge/tls
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL=720h
