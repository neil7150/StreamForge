# Set these privately in the provider Environment panel or a .env file.
# Never commit/upload actual secrets as part of the distribution archive.
DATABASE_URL=postgres://USER:PASSWORD@DATABASE_HOST:PORT/DB_NAME?sslmode=verify-full&sslrootcert=certs/postgres-ca.pem
AUTH_REDIS_URL=rediss://USERNAME:PASSWORD@AUTH_REDIS_HOST:PORT/0
CACHE_REDIS_URL=rediss://USERNAME:PASSWORD@CACHE_REDIS_HOST:PORT/0
JWT_SECRET=REPLACE_WITH_A_PRIVATE_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL=720h
# Default live mode requires CONFIG GET maxmemory-policy.
AUTH_REDIS_POLICY_MODE=live
# For Botkeep ONLY after staff confirms noeviction and persistence for this server:
# AUTH_REDIS_POLICY_MODE=botkeep-staff-confirmed
# AUTH_REDIS_ATTESTED_ENDPOINT=EXACT_AUTH_REDIS_HOST:PORT
# AUTH_REDIS_ATTESTATION=REPLACE_WITH_STAFF_TICKET_REFERENCE_AND_CONFIRMATION_DATE
# SERVER_PORT is assigned by Botkeep; do not copy a guessed value here.
# Use CA paths only when the provider supplies a private CA certificate.
# AUTH_REDIS_CA_FILE=certs/auth-redis-ca.pem
# CACHE_REDIS_CA_FILE=certs/cache-redis-ca.pem
# Optional verified SMTP settings for email verification delivery:
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# OAuth remains unconfigured until provider registrations are ready:
# FRONTEND_URL=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
