{
  "name": "streamforge",
  "version": "0.1.0",
  "private": true,
  "description": "StreamForge — Legal Torrent Streaming Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "validate:mobile": "node scripts/validate-mobile.mjs",
    "validate:mobile:native": "powershell -ExecutionPolicy Bypass -File apps/mobile/scripts/check-native-android.ps1",
    "dev": "npm run dev --workspace=apps/desktop",
    "build": "npm run build --workspace=apps/desktop",
    "test": "npm run test --workspace=apps/desktop",
    "build:verify": "npm run build:verify --workspace=apps/desktop"
  }
}
