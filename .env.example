# ============================================
# StreamForge — Environment Variables
# Copy to .env and fill in values
# ============================================

# PostgreSQL
DB_PASSWORD=streamforge_dev_password
POSTGRES_USER=streamforge
POSTGRES_PASSWORD=streamforge_dev_password

# Redis
REDIS_URL=redis://redis:6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL=720h

# MinIO (S3-compatible object storage)
MINIO_USER=streamforge
MINIO_PASSWORD=streamforge_minio_password

# Grafana
GRAFANA_PASSWORD=admin

# Services
AUTH_SERVICE_PORT=8001
CONTENT_SERVICE_PORT=8002
USER_SERVICE_PORT=8003
SEARCH_SERVICE_PORT=8004

# Environment
APP_ENV=development
LOG_LEVEL=debug
